<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
 <uses-permission android:name="android.permission.INTERNET" />
 <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
 <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
 <uses-permission android:name="android.permission.WAKE_LOCK" />
 <uses-permission android:name="dev.alex.afptranslate.USE_TRANSLATOR" />
 <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
 <queries><package android:name="dev.alex.afptranslate" /></queries>
 <application android:label="aFolderPlayer" android:icon="@drawable/ic_player" android:theme="@style/AppTheme" android:allowBackup="false" android:dataExtractionRules="@xml/data_extraction_rules" android:supportsRtl="true">
  <provider android:name=".ExtensionFileProvider" android:authorities="dev.alex.folderplayer.extensions" android:exported="false" android:grantUriPermissions="true" />
  <activity android:name=".DocumentActivity" android:exported="false" />
  <activity android:name=".MainActivity" android:exported="true">
   <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
  </activity>
  <!-- External media controls are checked by MediaSession.Callback.onConnect. -->
  <service tools:ignore="ExportedService" android:name=".PlaybackService" android:foregroundServiceType="mediaPlayback" android:exported="true">
   <intent-filter><action android:name="androidx.media3.session.MediaSessionService"/></intent-filter>
  </service>
 </application>
</manifest>
